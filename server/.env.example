# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas → Database → Connect → Drivers. Put the database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS and Socket.IO. Comma-separate several.
CLIENT_URL=http://localhost:5173

# Max register/login attempts per IP per 15 minutes (default: 50 in production, 100 in development)
# AUTH_RATE_LIMIT=50

# Uploads: profile/group pictures, voice notes, images (optional: without these, upload endpoints return 503)
# Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Chat Memory (optional: without a key, /api/ai returns 503)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used by aiMemory.js (optional; this is also the built-in default).
# Gemini 2.5 models are only served to accounts that already used them, so new keys need 3.x.
GEMINI_MODEL=gemini-3.5-flash-lite
